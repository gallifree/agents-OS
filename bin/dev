#!/bin/sh
# Local test stack. Usage: bin/dev [up|down|reset|logs [service]|ps]
#   up     (default) create deploy/.env with fresh secrets if missing, build, start, wait for the app
#   down   stop the stack, keep data
#   reset  stop the stack and wipe all data volumes
#   logs   follow logs (all services, or one)
#   ps     show service states
set -eu

self="$(cd "$(dirname "$0")" && pwd)/$(basename "$0")"
cd "$(dirname "$self")/../deploy"
compose() { docker compose "$@"; }

gen_env() {
  [ -f .env ] && return
  command -v openssl >/dev/null || { echo "openssl is required to generate secrets" >&2; exit 1; }
  sed -e "s#^MASTER_KEY=\$#MASTER_KEY=$(openssl rand -base64 32)#" \
      -e "s#^POSTGRES_PASSWORD=\$#POSTGRES_PASSWORD=$(openssl rand -hex 24)#" \
      -e "s#^TYPESENSE_API_KEY=\$#TYPESENSE_API_KEY=$(openssl rand -hex 24)#" \
      -e "s#^GARAGE_RPC_SECRET=\$#GARAGE_RPC_SECRET=$(openssl rand -hex 32)#" \
      -e "s#^GARAGE_ADMIN_TOKEN=\$#GARAGE_ADMIN_TOKEN=$(openssl rand -hex 32)#" \
      -e "s#^S3_ACCESS_KEY_ID=\$#S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12)#" \
      -e "s#^S3_SECRET_ACCESS_KEY=\$#S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32)#" \
      .env.example > .env
  echo "created deploy/.env with fresh secrets"
}

wait_app() {
  port=$(sed -n 's/^APP_PORT=//p' .env)
  port=${port:-8080}
  i=0
  until curl -fs -o /dev/null "http://localhost:$port/health"; do
    i=$((i + 1))
    if [ "$i" -ge 60 ]; then
      echo "app did not answer on :$port/health after 60s; see: bin/dev logs app" >&2
      exit 1
    fi
    sleep 1
  done
  echo "ready → http://localhost:$port"
  # Only logged while the instance has no users yet.
  code=$(compose logs app 2>/dev/null | grep -o 'setup code [0-9a-f-]*' | tail -1 | cut -d' ' -f3)
  if [ -n "$code" ]; then echo "first run → create the admin account with setup code: $code"; fi
}

case "${1:-up}" in
  up)
    gen_env
    compose up -d --build
    wait_app
    ;;
  down) compose down ;;
  reset)
    compose down -v
    echo "data volumes wiped (deploy/.env kept)"
    ;;
  logs) shift; compose logs -f "$@" ;;
  ps) compose ps -a ;;
  *) sed -n "2,7p" "$self" >&2; exit 2 ;;
esac
