# Copy to .env and fill in. Generate secrets with the commands shown.

# Browser profile: headless | chromium (never both). Add ,inference to run Ollama in the stack.
COMPOSE_PROFILES=headless

APP_PORT=8080
RUST_LOG=info

# openssl rand -base64 32  (never commit it, never store it in the database)
MASTER_KEY=

POSTGRES_USER=app
POSTGRES_DB=app
# openssl rand -hex 24
POSTGRES_PASSWORD=

# Valkey is the primary memory store: size it for your agents' history.
VALKEY_MAXMEMORY=1gb

# openssl rand -hex 24
TYPESENSE_API_KEY=

# Garage (built-in S3). openssl rand -hex 32 for both.
GARAGE_RPC_SECRET=
GARAGE_ADMIN_TOKEN=

# S3 credentials. With Garage: S3_ACCESS_KEY_ID=GK$(openssl rand -hex 12), S3_SECRET_ACCESS_KEY=$(openssl rand -hex 32).
# For AWS S3 or another provider, set S3_ENDPOINT / S3_REGION and use that provider's keys.
S3_BUCKET=assets
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=https://s3.eu-west-3.amazonaws.com
# S3_REGION=eu-west-3

# Inference on the host instead (e.g. native Ollama on macOS for Metal):
# INFERENCE_URL=http://host.docker.internal:11434
